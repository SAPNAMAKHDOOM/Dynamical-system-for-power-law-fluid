function psi = psi_field(x, y, n, mBr, q, phi)
% PSI_FIELD  Closed-form stream function psi(x,y) for peristalsis of a
% Power-law fluid with temperature-dependent viscosity, from Makhdoom et
% al. (2023), Eqs. (19) and (49a)-(49b).
%
%   n    - power-law index (0.5 shear-thinning, 1 Newtonian, 1.5 shear-thickening)
%   mBr  - modified Brinkman number (= alpha * Br in the paper's notation)
%   q    - volumetric flow rate
%   phi  - amplitude ratio
%
%

%
% IMPORTANT:please check again  equation (49a) to avoid error

    h = 1 - phi*(1 - cos(2*x));    % Eq. (19)

    if y >= 0
        psi = psi_pos(y, h, n, mBr, q);
    else
        psi = -psi_pos(-y, h, n, mBr, q);
    end
end

function val = psi_pos(y, h, n, mBr, q)
    % zeroth-order term
    C0 = (2*n + 1) / (2*(n + 1)) * (q + 2*h) * h^(-(1/n + 2));
    term0 = -y - C0 * ( (n/(2*n + 1)) * y^(1/n + 2) - h^(1/n + 1) * y );

    % modified-Brinkman-number correction term
    C1 = mBr * ( n^3 * (1 + 2*n)^n ) / ( (2*n)^(2 + n) * (2 + 5*n) ) ...
             * (q + 2*h)^(2 + n) * h^( -(1/n + 2) * (2 + n) );
    term1 = C1 * ( (1/(2*(3*n + 1))) * y^(2/n + 5) ...
                 - ((1 + 2*n)/((n + 1)*(3*n + 1))) * y^(1/n + 5) * h^(1/n + 3) ...
                 + (1/(2*(n + 1))) * h^(2/n + 4) * y );

    val = term0 + term1;
end
